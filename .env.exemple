# =========================
# LLM / API
# =========================

GROQ_API_KEY=

# =========================
# Google Cloud
# =========================

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=global

GEMINI_MODEL=gemini-2.5-flash

# =========================
# Local IAP Development
# =========================

IAP_LOCAL_DEV=true
IAP_DEV_USER_EMAIL=your-email@example.com

# Optional if using an explicit service-account key locally.
# Prefer Application Default Credentials when possible.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# =========================
# Google OAuth
# =========================

GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/gcp/auth/callback

FRONTEND_URL=http://localhost:5173

SESSION_SECRET=replace-with-a-secure-random-secret

# LOCAL DEVELOPMENT ONLY
OAUTHLIB_INSECURE_TRANSPORT=1

# =========================
# BigQuery Cost Management
# =========================

BIGQUERY_ON_DEMAND_PRICE_PER_TIB=6.25
BIGQUERY_MAX_ESTIMATED_COST_USD=1.00

# =========================
# Controlled BigQuery Runtime Validation
# =========================

# IMPORTANT:
# Enabling this executes real BigQuery queries and may incur cost.
# Keep disabled unless runtime benchmarking is intentionally required.
BIGQUERY_RUNTIME_VALIDATION_ENABLED=false

# 1 GiB safety ceiling
BIGQUERY_RUNTIME_VALIDATION_MAX_BYTES=1073741824

# Maximum wait per benchmark query
BIGQUERY_RUNTIME_VALIDATION_TIMEOUT_SECONDS=30

# Minimum slot-time improvement required for runtime approval
BIGQUERY_RUNTIME_MIN_IMPROVEMENT_PERCENT=5.0

# Number of paired benchmark runs.
# 3 pairs = 6 real BigQuery executions.
BIGQUERY_RUNTIME_BENCHMARK_PAIRS=3

# Candidate must outperform the original query in at least this many pairs.
BIGQUERY_RUNTIME_MIN_WIN_COUNT=2

# =========================
# Redis
# =========================

REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=sqlagent

REDIS_SESSION_TTL_SECONDS=28800
REDIS_CONVERSATION_TTL_SECONDS=28800
REDIS_STATE_TTL_SECONDS=3600
REDIS_METADATA_TTL_SECONDS=300
REDIS_CATALOG_TTL_SECONDS=900

# =========================
# Agent Strategy
# =========================

SQL_AGENT_STRATEGY_ENABLED=true
SQL_AGENT_STRATEGY_MODEL=gemini-2.5-flash
